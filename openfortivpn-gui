#!/usr/bin/env python3
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AppIndicator3", "0.1")
from gi.repository import Gtk, Gdk, GLib, AppIndicator3

import json
import os
import subprocess
import time

CONFIG_DIR = os.path.expanduser("~/.config/openfortivpn-gui")
PROFILE_DIR = "/etc/openfortivpn"
STATE_FILE = os.path.join(CONFIG_DIR, "state.json")
HISTORY_FILE = os.path.join(CONFIG_DIR, "history.json")
LOG = "/tmp/openfortivpn-gui.log"
START_FILE = "/tmp/openfortivpn-gui.start"
SUDO = ["sudo", "-n"]
RETENTION_SECONDS = 7 * 24 * 3600
ICON_ON = "network-vpn"
ICON_OFF = "network-offline"

CSS = b"""
#connect_button {
  padding: 10px 16px;
  font-weight: bold;
  font-size: 14px;
}
#profile_combo {
  padding: 4px 6px;
}
"""


def list_profiles():
    try:
        entries = os.listdir(PROFILE_DIR)
    except OSError:
        return []
    names = []
    for e in sorted(entries):
        if e == "config" or e.endswith(".conf"):
            p = os.path.join(PROFILE_DIR, e)
            if os.path.isfile(p):
                names.append(e)
    return names


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f, indent=2)


def load_state():
    d = load_json(STATE_FILE, {})
    return d if isinstance(d, dict) else {}


def save_state(d):
    save_json(STATE_FILE, d)


def load_history():
    h = load_json(HISTORY_FILE, [])
    return h if isinstance(h, list) else []


def save_history(h):
    save_json(HISTORY_FILE, purge_old(h))


def purge_old(records):
    cutoff = time.time() - RETENTION_SECONDS
    return [r for r in records if isinstance(r, dict) and r.get("start", 0) >= cutoff]


def tunnel_iface():
    net = "/sys/class/net"
    try:
        for name in os.listdir(net):
            if name.startswith(("ppp", "tun")):
                return name
    except OSError:
        pass
    return None


def fmt(seconds):
    seconds = max(0, int(seconds))
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"


class VpnApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="local.openfortivpn.gui")
        self.win = None
        self.ind = None
        self.status = None
        self.time_label = None
        self.spinner = None
        self.btn = None
        self.profile_combo = None
        self.store = None
        self.menu_status = None
        self.menu_time = None
        self.menu_toggle = None
        self.prof_parent = None

        self.profiles = list_profiles()
        last = load_state().get("last_profile")
        self.profile = (
            last if last in self.profiles else (self.profiles[0] if self.profiles else None)
        )

        self.state = "disconnected"
        self.connecting = False
        self.connected_at = None
        self.session_start = None
        self.session_profile = None
        self.stopping_until = 0.0

    def do_activate(self):
        if self.win is not None:
            self.win.present()
            return

        self._apply_css()

        self.win = Gtk.ApplicationWindow(application=self)
        self.win.set_title("OpenFortiVPN")
        self.win.set_default_size(400, 480)
        self.win.connect("delete-event", self.on_delete)

        hb = Gtk.HeaderBar()
        hb.set_show_close_button(True)
        self.win.set_titlebar(hb)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.set_margin_top(12)
        root.set_margin_bottom(12)
        root.set_margin_start(12)
        root.set_margin_end(12)
        self.win.add(root)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(200)

        switcher = Gtk.StackSwitcher()
        switcher.set_stack(self.stack)
        switcher.set_halign(Gtk.Align.CENTER)
        root.pack_start(switcher, False, False, 0)

        root.pack_start(self.stack, True, True, 0)

        self._build_connect_page()
        self._build_history_page()
        self.build_tray()

        save_history(load_history())

        if self._running():
            if tunnel_iface():
                self.state = "connected"
                try:
                    self.connected_at = float(open(START_FILE).read().strip())
                except Exception:
                    self.connected_at = time.time()
                self.session_start = self.connected_at
                self.session_profile = self.profile
            else:
                self.state = "connecting"
                self.connecting = True

        self.refresh_history()
        self.update()
        self.win.show_all()
        GLib.timeout_add_seconds(1, self._tick)

    def _apply_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    def _build_connect_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_top(16)
        box.set_margin_bottom(16)
        box.set_margin_start(24)
        box.set_margin_end(24)

        prof_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        prof_lbl = Gtk.Label("VPN:")
        prof_box.pack_start(prof_lbl, False, False, 0)
        self.profile_combo = Gtk.ComboBoxText()
        self.profile_combo.set_name("profile_combo")
        for name in self.profiles:
            self.profile_combo.append_text(name)
        if self.profile:
            self.profile_combo.set_active(self.profiles.index(self.profile))
        self.profile_combo.connect("changed", self.on_profile_changed)
        prof_box.pack_start(self.profile_combo, True, True, 0)
        box.pack_start(prof_box, False, False, 0)

        self.status = Gtk.Label(halign=Gtk.Align.CENTER)
        box.pack_start(self.status, False, False, 0)

        self.spinner = Gtk.Spinner()
        self.spinner.set_halign(Gtk.Align.CENTER)
        self.spinner.set_visible(False)
        box.pack_start(self.spinner, False, False, 0)

        self.time_label = Gtk.Label(halign=Gtk.Align.CENTER)
        box.pack_start(self.time_label, False, False, 0)

        self.btn = Gtk.Button(label="Ligar VPN")
        self.btn.set_name("connect_button")
        self.btn.set_halign(Gtk.Align.CENTER)
        self.btn.connect("clicked", self.on_btn)
        box.pack_start(self.btn, False, False, 0)

        self.stack.add_titled(box, "connect", "Conexão")

    def _build_history_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_margin_top(8)
        box.set_margin_bottom(8)
        box.set_margin_start(12)
        box.set_margin_end(12)

        self.store = Gtk.ListStore(str, str, str)
        tree = Gtk.TreeView(model=self.store)
        tree.set_headers_visible(True)
        for title, idx in (("Início", 0), ("VPN", 1), ("Duração", 2)):
            col = Gtk.TreeViewColumn(title, Gtk.CellRendererText(), text=idx)
            col.set_expand(idx == 0)
            tree.append_column(col)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_min_content_height(260)
        scrolled.add(tree)
        box.pack_start(scrolled, True, True, 0)

        self.stack.add_titled(box, "history", "Histórico")

    def build_tray(self):
        self.menu_status = Gtk.MenuItem()
        self.menu_time = Gtk.MenuItem()
        self.menu_status.set_sensitive(False)
        self.menu_time.set_sensitive(False)

        prof_menu = Gtk.Menu()
        group = []
        for name in self.profiles:
            item = Gtk.RadioMenuItem.new_with_label(group, name)
            group = item.get_group()
            item.connect("activate", self.on_profile_item, name)
            if name == self.profile:
                item.set_active(True)
            prof_menu.append(item)
        self.prof_parent = Gtk.MenuItem(f"VPN: {self.profile or '-'}")
        self.prof_parent.set_submenu(prof_menu)

        self.menu_toggle = Gtk.MenuItem("Ligar VPN")
        self.menu_toggle.connect("activate", lambda *a: self.on_btn(None))

        menu_show = Gtk.MenuItem("Mostrar janela")
        menu_show.connect("activate", lambda *a: self.show_win())

        menu_quit = Gtk.MenuItem("Sair")
        menu_quit.connect("activate", lambda *a: self.on_quit())

        menu = Gtk.Menu()
        menu.append(self.menu_status)
        menu.append(self.menu_time)
        menu.append(Gtk.SeparatorMenuItem())
        menu.append(self.prof_parent)
        menu.append(self.menu_toggle)
        menu.append(menu_show)
        menu.append(Gtk.SeparatorMenuItem())
        menu.append(menu_quit)
        menu.show_all()

        self.ind = AppIndicator3.Indicator.new(
            "openfortivpn-tray",
            ICON_OFF,
            AppIndicator3.IndicatorCategory.APPLICATION_STATUS,
        )
        self.ind.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
        self.ind.set_menu(menu)
        self.ind.set_title("OpenFortiVPN")

    def show_win(self):
        if self.win is not None:
            self.win.present()

    def on_delete(self, _w, _e):
        self.win.hide()
        return True

    def on_quit(self):
        if self._running():
            self.stop()
        self.quit()

    def _running(self):
        try:
            subprocess.run(
                ["pgrep", "-x", "openfortivpn"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True,
            )
            return True
        except (subprocess.CalledProcessError, FileNotFoundError):
            return False

    def on_profile_changed(self, combo):
        name = combo.get_active_text()
        if name and name != self.profile:
            self.profile = name
            self.save_last_profile()
            self.update_tray_profile()

    def on_profile_item(self, _item, name):
        if name != self.profile:
            self.profile = name
            self.save_last_profile()
            if self.profile_combo and name in self.profiles:
                self.profile_combo.set_active(self.profiles.index(name))
            self.update_tray_profile()

    def save_last_profile(self):
        d = load_state()
        d["last_profile"] = self.profile
        save_state(d)

    def update_tray_profile(self):
        if self.prof_parent:
            self.prof_parent.set_label(f"VPN: {self.profile or '-'}")

    def on_btn(self, _btn):
        if self.connecting or self.connected_at is not None:
            self.stop()
        else:
            self.start()

    def start(self):
        if not self.profile:
            self.notify("Nenhum perfil de VPN configurado", "dialog-error")
            return
        self.save_last_profile()
        cfg = os.path.join(PROFILE_DIR, self.profile)
        with open(LOG, "a") as f:
            f.write(f"\n--- connect {self.profile} {time.ctime()} ---\n")
            subprocess.Popen(
                SUDO + ["openfortivpn", "-c", cfg],
                stdout=f,
                stderr=f,
                start_new_session=True,
            )
        self.connecting = True
        self.connected_at = None
        self.session_start = None
        self.session_profile = None
        self.state = "connecting"
        self.update()

    def stop(self):
        subprocess.run(
            SUDO + ["pkill", "-x", "openfortivpn"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        dur = None
        if self.connected_at is not None:
            dur = fmt(time.time() - self.connected_at)
            self.add_history(
                self.session_start or self.connected_at,
                time.time(),
                self.session_profile or self.profile or "?",
            )
        self.connecting = False
        self.connected_at = None
        self.session_start = None
        self.session_profile = None
        self.stopping_until = time.time() + 3
        self.state = "disconnected"
        try:
            os.remove(START_FILE)
        except OSError:
            pass
        self.update()
        if dur:
            self.notify(f"Desconectado — tempo de conexão: {dur}", ICON_OFF)
        else:
            self.notify("Cancelado", ICON_OFF)

    def _tick(self):
        if time.time() < self.stopping_until:
            return True

        running = self._running()
        iface = tunnel_iface()

        if not running:
            if self.state == "connected":
                dur = fmt(time.time() - self.connected_at) if self.connected_at else "00:00:00"
                self.add_history(
                    self.session_start or self.connected_at,
                    time.time(),
                    self.session_profile or self.profile or "?",
                )
                self.notify(f"Desconectado — tempo de conexão: {dur}", ICON_OFF)
            elif self.state == "connecting":
                self.notify("Falha ao conectar", "dialog-error")
            self.connecting = False
            self.connected_at = None
            self.session_start = None
            self.session_profile = None
            self.state = "disconnected"
            try:
                os.remove(START_FILE)
            except OSError:
                pass
            self.update()
        elif iface:
            self.connecting = False
            if self.connected_at is None:
                self.connected_at = time.time()
                self.session_start = self.connected_at
                self.session_profile = self.profile
                try:
                    open(START_FILE, "w").write(str(self.connected_at))
                except OSError:
                    pass
            if self.state != "connected":
                self.notify("Conectado à VPN", ICON_ON)
            self.state = "connected"
            self.update()
        else:
            self.connecting = True
            self.connected_at = None
            self.session_start = None
            self.session_profile = None
            self.state = "connecting"
            self.update()

        return True

    def add_history(self, start, end, profile):
        if not start:
            return
        records = load_history()
        records.append(
            {
                "profile": profile,
                "start": start,
                "end": end,
                "duration": int(max(0, end - start)),
            }
        )
        save_history(records)
        self.refresh_history()

    def refresh_history(self):
        if self.store is None:
            return
        self.store.clear()
        records = sorted(load_history(), key=lambda r: r.get("start", 0), reverse=True)
        for r in records:
            start_s = time.strftime("%d/%m %H:%M", time.localtime(r["start"]))
            self.store.append(
                [start_s, r.get("profile", "?"), fmt(r.get("duration", 0))]
            )

    def notify(self, msg, icon=ICON_ON):
        subprocess.Popen(
            ["notify-send", "-i", icon, "OpenFortiVPN", msg],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    def update(self):
        idle = not self.connecting and self.connected_at is None
        if self.profile_combo:
            self.profile_combo.set_sensitive(idle and bool(self.profiles))
        if not self.profiles:
            self.btn.set_sensitive(False)

        if self.connecting:
            self.status.set_markup(
                '<span size="x-large" weight="bold" foreground="#e5a50a">Conectando…</span>'
            )
            self.time_label.set_markup('<span size="large">Estabelecendo túnel…</span>')
            self.btn.set_label("Cancelar")
            self.spinner.set_visible(True)
            self.spinner.start()
            self.menu_status.set_label("Status: Conectando…")
            self.menu_time.set_label("Estabelecendo túnel…")
            self.menu_toggle.set_label("Cancelar")
            self.ind.set_icon(ICON_ON)
        elif self.connected_at is not None:
            elapsed = fmt(time.time() - self.connected_at)
            self.status.set_markup(
                '<span size="x-large" weight="bold" foreground="#26a269">Conectado</span>'
            )
            self.time_label.set_markup(
                f'<span size="large">Tempo de conexão: {elapsed}</span>'
            )
            self.btn.set_label("Desligar VPN")
            self.spinner.stop()
            self.spinner.set_visible(False)
            self.menu_status.set_label("Status: Conectado")
            self.menu_time.set_label(f"Tempo: {elapsed}")
            self.menu_toggle.set_label("Desligar VPN")
            self.ind.set_icon(ICON_ON)
        else:
            self.status.set_markup(
                '<span size="x-large" weight="bold" foreground="#a51d2d">Desconectado</span>'
            )
            self.time_label.set_markup('<span size="large"> </span>')
            self.btn.set_label("Ligar VPN")
            self.spinner.stop()
            self.spinner.set_visible(False)
            self.menu_status.set_label("Status: Desconectado")
            self.menu_time.set_label(" ")
            self.menu_toggle.set_label("Ligar VPN")
            self.ind.set_icon(ICON_OFF)


if __name__ == "__main__":
    app = VpnApp()
    app.run(None)
